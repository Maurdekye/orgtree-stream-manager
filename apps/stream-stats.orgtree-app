{"format":"orgtree-app","version":1,"definition":{"name":"Stream stats","description":"Read-only stream stats in one live view: chat, donations, rate limits and moderation, from the stream manager's stats.json in this org's scratch folder.","html":"<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<title>Stream stats</title>\n<style>\n  :root {\n    color-scheme: var(--orgtree-color-scheme, light dark);\n    --bg: var(--orgtree-bg, #ffffff);\n    --card: var(--orgtree-card, #f6f6f7);\n    --text: var(--orgtree-text, #1f2328);\n    --strong: var(--orgtree-text-strong, #0b0d10);\n    --dim: var(--orgtree-text-dim, #6b7280);\n    --border: var(--orgtree-border, #d0d7de);\n    --soft: var(--orgtree-border-soft, #e5e7eb);\n    --accent: var(--orgtree-accent, #6366f1);\n    --accent-soft: var(--orgtree-accent-soft, #eef2ff);\n    --ok: var(--orgtree-success, #16a34a);\n    --warn: var(--orgtree-warning, #d97706);\n    --bad: var(--orgtree-danger, #dc2626);\n  }\n  * { box-sizing: border-box; }\n  html, body { height: 100%; }\n  body { margin: 0; font: 12px/1.35 system-ui, sans-serif; background: var(--bg); color: var(--text); display: flex; flex-direction: column; overflow: hidden; }\n  header { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; padding: 8px 10px; border-bottom: 1px solid var(--border); }\n  .chip { padding: 2px 8px; border-radius: 999px; border: 1px solid var(--border); background: var(--card); white-space: nowrap; }\n  .chip.live { border-color: var(--ok); color: var(--ok); }\n  .chip.afk { border-color: var(--warn); color: var(--warn); }\n  .chip.offline { color: var(--dim); }\n  .stat { color: var(--dim); }\n  .stat b { color: var(--strong); font-weight: 600; }\n  .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--dim); display: inline-block; }\n  .dot.up { background: var(--ok); } .dot.down { background: var(--bad); }\n  #stale { display: none; padding: 6px 10px; background: var(--warn); color: #000; }\n  #stale.show { display: block; }\n  /* One view, nothing to click (USER m87e53ef60dbe): chat fills the left column; the other three stack on the right.\n     Newest rows come first and older ones are clipped, so nothing ever needs scrolling. */\n  main { flex: 1; min-height: 0; display: grid; gap: 6px; padding: 6px; grid-template-columns: 1.5fr 1fr; grid-template-rows: 1fr 1fr 1fr;\n         grid-template-areas: \"chat donations\" \"chat limits\" \"chat moderation\"; }\n  section { min-height: 0; overflow: hidden; border: 1px solid var(--soft); border-radius: 6px; background: var(--bg); display: flex; flex-direction: column; }\n  section h2 { margin: 0; padding: 3px 8px; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .04em; color: var(--dim); background: var(--card); border-bottom: 1px solid var(--soft); }\n  section .body { flex: 1; min-height: 0; overflow: hidden; padding: 0 4px; }\n  #sec-chat { grid-area: chat; } #sec-donations { grid-area: donations; } #sec-limits { grid-area: limits; } #sec-moderation { grid-area: moderation; }\n  .detail { color: var(--dim); padding: 2px 6px; border-bottom: 1px solid var(--soft); }\n  table { width: 100%; border-collapse: collapse; }\n  th, td { text-align: left; padding: 2px 4px; border-bottom: 1px solid var(--soft); vertical-align: top; }\n  th { color: var(--dim); font-weight: 500; position: sticky; top: 0; background: var(--bg); }\n  td.text { white-space: pre-wrap; word-break: break-word; }\n  .tag { font-size: 11px; padding: 0 6px; border-radius: 4px; border: 1px solid var(--border); }\n  .tag.ok { color: var(--ok); border-color: var(--ok); }\n  .tag.held { color: var(--warn); border-color: var(--warn); }\n  .tag.filtered { color: var(--bad); border-color: var(--bad); }\n  .empty { color: var(--dim); padding: 6px 4px; }\n  .num { text-align: right; font-variant-numeric: tabular-nums; }\n</style>\n</head>\n<body>\n<header id=\"head\">\n  <span class=\"chip offline\" id=\"state-twitch\">Twitch · offline</span>\n  <span class=\"chip offline\" id=\"state-youtube\">YouTube · offline</span>\n  <span class=\"chip\" id=\"gate\">Gate · unknown</span>\n  <span class=\"stat\">uptime <b id=\"uptime\">–</b></span>\n  <span class=\"stat\">viewers <b id=\"viewers\">–</b></span>\n  <span class=\"stat\">session <b id=\"total\">$0</b></span>\n  <span class=\"dot\" id=\"health\" title=\"Connections\"></span>\n</header>\n<div id=\"stale\" role=\"status\">Stream manager not updating.</div>\n<main>\n  <section id=\"sec-chat\"><h2>Chat</h2><div class=\"body\" id=\"body-chat\"></div></section>\n  <section id=\"sec-donations\"><h2>Donations</h2><div class=\"body\" id=\"body-donations\"></div></section>\n  <section id=\"sec-limits\"><h2>Rate limits</h2><div class=\"detail\" id=\"gate-detail\"></div><div class=\"body\" id=\"body-limits\"></div></section>\n  <section id=\"sec-moderation\"><h2>Moderation</h2><div class=\"body\" id=\"body-moderation\"></div></section>\n</main>\n<script>\n// Stream manager stats panel: pure helpers (plan section 11). No DOM, no network.\n// Loaded by Node for tests (module.exports) and inlined into the panel HTML (window.StatsLib).\n(function (root) {\n  'use strict';\n\n  /** Decodes the base64 bytes of stats.json (UTF-8 JSON) into an object. */\n  function decodeSnapshot(base64) {\n    const bin = atob(base64);\n    const bytes = new Uint8Array(bin.length);\n    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);\n    return JSON.parse(new TextDecoder('utf-8').decode(bytes));\n  }\n\n  /** Seconds from nowMs until an ISO time (negative when past); NaN for a bad time. */\n  function secondsUntil(iso, nowMs) {\n    const t = Date.parse(iso);\n    return Number.isNaN(t) ? NaN : (t - nowMs) / 1000;\n  }\n\n  /** A countdown: \"now\", \"45 s\", \"1:05\", \"1 h 05 min\". */\n  function formatCountdown(seconds) {\n    if (!(seconds > 0)) return 'now';\n    const s = Math.ceil(seconds);\n    if (s < 60) return s + ' s';\n    if (s < 3600) return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');\n    return Math.floor(s / 3600) + ' h ' + String(Math.floor((s % 3600) / 60)).padStart(2, '0') + ' min';\n  }\n\n  function trim(n) {\n    return Number.isInteger(n) ? String(n) : String(Math.round(n * 10) / 10);\n  }\n\n  /** The gate's minimum time: \"no wait\", \"30 s\", \"2 min\", \"4.5 min\", \"1.5 h\". */\n  function formatInterval(seconds) {\n    if (!(seconds > 0)) return 'no wait';\n    if (seconds < 60) return trim(seconds) + ' s';\n    if (seconds < 3600) return trim(seconds / 60) + ' min';\n    return trim(seconds / 3600) + ' h';\n  }\n\n  function formatUsd(x) {\n    if (typeof x !== 'number' || !Number.isFinite(x)) return '?';\n    return Number.isInteger(x) ? String(x) : x.toFixed(2);\n  }\n\n  /** \"Gate · 10 min · $0\". */\n  function gateLabel(gate) {\n    if (!gate) return 'Gate · unknown';\n    return 'Gate · ' + formatInterval(gate.min_interval_s) + ' · $' + formatUsd(gate.min_donation_usd);\n  }\n\n  /** 0 at no wait / $0, rising to 1 at 10 min or $5 (for the chip's tint). */\n  function gateSeverity(gate) {\n    if (!gate) return 0;\n    const m = (gate.min_interval_s || 0) / 600;\n    const d = (gate.min_donation_usd || 0) / 5;\n    return Math.max(0, Math.min(1, Math.max(m, d)));\n  }\n\n  /** True when the snapshot is older than maxAgeS (default 30 s) or unreadable. */\n  function isStale(atIso, nowMs, maxAgeS) {\n    const age = -secondsUntil(atIso, nowMs);\n    return !(age <= (maxAgeS === undefined ? 30 : maxAgeS));\n  }\n\n  /** Chat status chip: {label, kind} with kind ok | held | filtered. */\n  function statusChip(status) {\n    if (status === 'forwarded') return { label: 'sent', kind: 'ok' };\n    if (typeof status === 'string' && status.indexOf('held:') === 0) {\n      return { label: 'held · ' + status.slice(5).replace('_', ' '), kind: 'held' };\n    }\n    return { label: String(status || 'unknown'), kind: 'filtered' };\n  }\n\n  const api = { decodeSnapshot, secondsUntil, formatCountdown, formatInterval, formatUsd, gateLabel, gateSeverity, isStale, statusChip };\n  if (typeof module !== 'undefined' && module.exports) module.exports = api;\n  else root.StatsLib = api;\n})(typeof self !== 'undefined' ? self : this);\n\n</script>\n<script>\n(function () {\n  'use strict';\n  // Viewer names and messages are untrusted: they are only ever set as textContent.\n  const L = window.StatsLib;\n  const PATH = 'stream-manager/stats.json';\n  const POLL_MS = 5000;\n  let snap = null;\n  let error = '';\n\n  function el(tag, attrs, children) {\n    const e = document.createElement(tag);\n    if (attrs) for (const k of Object.keys(attrs)) {\n      if (k === 'text') e.textContent = attrs[k];\n      else if (k === 'class') e.className = attrs[k];\n      else e.setAttribute(k, attrs[k]);\n    }\n    if (children) for (const c of children) e.appendChild(c);\n    return e;\n  }\n  function time(iso) {\n    const t = Date.parse(iso);\n    return Number.isNaN(t) ? '' : new Date(t).toLocaleTimeString();\n  }\n  function table(headers, rows, emptyText) {\n    if (!rows.length) return el('div', { class: 'empty', text: emptyText });\n    const thead = el('thead', null, [el('tr', null, headers.map(h => el('th', { text: h })))]);\n    const tbody = el('tbody', null, rows.map(r => el('tr', null, r)));\n    return el('table', null, [thead, tbody]);\n  }\n  function td(text, cls) { return el('td', { text: text == null ? '' : String(text), class: cls || '' }); }\n\n  function renderHeader() {\n    const s = (snap && snap.state) || {};\n    for (const p of ['twitch', 'youtube']) {\n      const st = s[p] || 'offline';\n      const chip = document.getElementById('state-' + p);\n      chip.className = 'chip ' + (st === 'live' ? 'live' : st === 'afk' ? 'afk' : 'offline');\n      chip.textContent = (p === 'twitch' ? 'Twitch' : 'YouTube') + ' · ' + st.toUpperCase();\n    }\n    const gate = snap && snap.gate;\n    const g = document.getElementById('gate');\n    g.textContent = L.gateLabel(gate);\n    const sev = L.gateSeverity(gate);\n    g.style.borderColor = sev > 0 ? 'color-mix(in srgb, var(--warn) ' + Math.round(sev * 100) + '%, var(--border))' : '';\n    const tip = [];\n    if (gate) {\n      if (gate.by) tip.push('set by ' + gate.by);\n      if (gate.reason) tip.push('reason: ' + gate.reason);\n      if (typeof gate.interruptions_per_min_5 === 'number') tip.push(gate.interruptions_per_min_5 + ' interruptions/min (5 min)');\n      if (gate.relax_at) tip.push('relaxes in ' + L.formatCountdown(L.secondsUntil(gate.relax_at, Date.now())));\n    }\n    g.title = tip.join('\\n');\n    // The tooltip needs a hover; the same detail is also shown in the Rate limits section.\n    document.getElementById('gate-detail').textContent = [L.gateLabel(gate)].concat(tip).join(' · ');\n    const up = s.uptime_s;\n    document.getElementById('uptime').textContent = typeof up === 'number' ? L.formatCountdown(up) : '–';\n    const v = s.viewers || {};\n    const vt = (v.twitch || 0) + (v.youtube || 0);\n    document.getElementById('viewers').textContent = s.viewers ? String(vt) : '–';\n    const tot = snap && snap.totals;\n    document.getElementById('total').textContent = '$' + L.formatUsd(tot ? tot.session_usd : 0);\n    const h = (snap && snap.health) || {};\n    const parts = Object.keys(h).filter(k => typeof h[k] === 'string');\n    const allUp = parts.length > 0 && parts.every(k => h[k] === 'up');\n    const dot = document.getElementById('health');\n    dot.className = 'dot ' + (parts.length === 0 ? '' : allUp ? 'up' : 'down');\n    dot.title = parts.map(k => k + ': ' + h[k]).join('\\n') || 'no health data';\n    const stale = document.getElementById('stale');\n    const isStale = !snap || L.isStale(snap.at, Date.now());\n    stale.className = isStale ? 'show' : '';\n    stale.textContent = error ? 'Stream manager not updating: ' + error : 'Stream manager not updating.';\n  }\n\n  function renderChat() {\n    const rows = ((snap && snap.chat) || []).slice().reverse().map(c => {\n      const chip = L.statusChip(c.status);\n      return [td(time(c.ts)), td(c.platform === 'youtube' ? c.viewer + ' (YT)' : c.viewer), td(c.text, 'text'), el('td', null, [el('span', { class: 'tag ' + chip.kind, text: chip.label })])];\n    }).slice(0, 40);\n    document.getElementById('body-chat').replaceChildren(table(['Time', 'Viewer', 'Message', 'Status'], rows, 'No chat yet.'));\n  }\n  function renderDonations() {\n    const rows = ((snap && snap.donations) || []).slice().reverse().slice(0, 12).map(d => [\n      td(time(d.ts)), td(d.donor), td(d.source), td(d.usd == null ? '?' : '$' + L.formatUsd(d.usd), 'num'), td(d.text, 'text')\n    ]);\n    document.getElementById('body-donations').replaceChildren(table(['Time', 'Donor', 'Source', 'USD', 'Message'], rows, 'No donations yet.'));\n  }\n  function renderLimits() {\n    const now = Date.now();\n    const rows = ((snap && snap.limits) || []).map(l => {\n      const until = l.held_until ? L.secondsUntil(l.held_until, now) : L.secondsUntil(l.next_allowed_at, now);\n      const left = l.held_until ? 'held ' + L.formatCountdown(until) : L.formatCountdown(until);\n      return [td(l.name || l.viewer), td('$' + L.formatUsd(l.credit_usd), 'num'), td(l.max_chars, 'num'), td(left, 'num')];\n    }).slice(0, 12);\n    document.getElementById('body-limits').replaceChildren(table(['Viewer', 'Credit', 'Max chars', 'Can post in'], rows, 'Nobody is waiting.'));\n  }\n  function renderModeration() {\n    const mod = ((snap && snap.moderation) || []).map(m => ({ ts: m.ts, what: m.action, target: m.target, by: m.by, reason: m.reason }));\n    const gates = ((snap && snap.gate_history) || []).map(g => ({ ts: g.ts, what: 'gate ' + g.value, target: g.from + ' → ' + g.to, by: g.by, reason: g.reason }));\n    const rows = mod.concat(gates).sort((a, b) => Date.parse(b.ts) - Date.parse(a.ts)).slice(0, 12).map(m => [td(time(m.ts)), td(m.what), td(m.target), td(m.by), td(m.reason, 'text')]);\n    document.getElementById('body-moderation').replaceChildren(table(['Time', 'Action', 'Target', 'By', 'Reason'], rows, 'No moderation yet.'));\n  }\n  function renderAll() { renderHeader(); renderChat(); renderDonations(); renderLimits(); renderModeration(); }\n\n  async function poll() {\n    try {\n      // [verify] files.open/read return shapes at the live trial; both forms are accepted.\n      const ref = await orgtree.files.open('scratch', PATH);\n      const id = ref && typeof ref === 'object' ? (ref.id || ref.file) : ref;\n      const r = await orgtree.files.read(id, { offset: 0, limit: 65536 });\n      if (r && r.eof === false) throw new Error('snapshot larger than one read');\n      snap = L.decodeSnapshot(r.base64 || r.data);\n      error = '';\n    } catch (e) {\n      error = (e && e.message) ? e.message : 'read failed';\n    }\n    renderAll();\n  }\n\n  renderAll();\n  poll();\n  setInterval(poll, POLL_MS);\n  setInterval(() => { renderHeader(); renderLimits(); }, 1000); // live countdowns between reads\n})();\n</script>\n</body>\n</html>\n","initial_state":{},"capabilities":[],"events":[],"width":760,"height":560},"panels":[]}